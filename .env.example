# Local development only. On Render these are set by render.yaml.

# PostgreSQL connection string
DATABASE_URL="postgresql://tradelens:tradelens@localhost:5432/tradelens"

# Public URL of the app. On Render this is filled in automatically from
# RENDER_EXTERNAL_URL; set it only if you use a custom domain.
NEXTAUTH_URL="http://localhost:3000"

# Long random secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
